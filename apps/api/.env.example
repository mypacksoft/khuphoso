# ───────── Cấu hình KhuPhoSo API ─────────
# Copy file này thành ".env" (cùng thư mục apps/api) rồi điền giá trị thật.
# TUYỆT ĐỐI không commit file .env lên git.

# PostgreSQL (khuyến nghị PostgreSQL 16 + PostGIS)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=qlkp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=doi_mat_khau_nay

# Tài khoản ứng dụng (không phải superuser) — tuỳ chọn, để trống thì dùng tài khoản trên
POSTGRES_APP_USER=
POSTGRES_APP_PASSWORD=

# Khoá ký token đăng nhập — đặt chuỗi ngẫu nhiên dài, giữ bí mật
SECRET_KEY=thay_bang_chuoi_ngau_nhien_that_dai

# Tên miền phục vụ (dùng cho CORS và nhận diện khu phố theo subdomain)
PUBLIC_DOMAIN=khuphoso.vn

API_PORT=8100
TZ=Asia/Ho_Chi_Minh
ENVIRONMENT=production

# Tuỳ chọn: khoá Google Geocoding để dò toạ độ từ địa chỉ (có thể để trống)
GOOGLE_MAPS_API_KEY=

# Key kích hoạt phần mềm — BẮT BUỘC để chạy được nghiệp vụ.
# Đăng ký bản cài tại https://khuphoso.vn/dang-ky-repo (hoặc email
# montacapital2026@gmail.com) để nhận key, rồi dán vào đây và khởi động lại API.
LICENSE_KEY=
